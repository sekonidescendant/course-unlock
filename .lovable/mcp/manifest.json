    "issuer": "https://qiglkvwbtwkqhghzfpzq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "course-unlock",
      "version": "0.1.0",
      "title": "Course Unlock"
    },
    "tools": [
      {
        "name": "list_courses",
        "title": "List courses",
        "description": "List Mass Communication courses, optionally filtered by level and semester.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "level": {
              "type": "integer",
              "description": "Level, e.g. 100."
            },
            "semester": {
              "type": "string",
              "description": "Semester, e.g. 'first' or 'second'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_course_outline",
        "title": "Get course outline",
        "description": "Get the 10-week outline for a course by its code (e.g. 'MCM 101').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 2,
              "description": "Course code."
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_unlocked_courses",
        "title": "List my unlocked courses",
